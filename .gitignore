# ~~ peaclock
apps/cli/peaclock/.peaclock/history

# ~ btop
**/btop.conf
**/*/dynamic.micro
.peaclock/config

# secrets / keys - never public
*.pem
*.key
id_*
.credentials*
credentials*

# local-only state
*history*
.zsh_history
.gnupg/
.ssh/
.venv/
__pycache__/
*.pyc

# personal vault state
**/workspace.json

# editor / tool backups - never track
*.bak
*~
*.orig
*.swp
*.swo

# ignore dynamic-branch machine-specific leftovers (same-machine branch switches)
apps/tty/xresources/variants/dynamic
apps/notifier/dunst/.config/dunst/variants/dynamicrc
apps/capture/flameshot/.config/flameshot/variants/dynamic.ini
apps/cli/peaclock/.peaclock/variants/dynamic.conf
