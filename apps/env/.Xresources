! Black color that will not be affected by bold highlighting.
*.base066: #14140d
*base066:  #14140d

! Xclock colors.
XClock*foreground: #e6e2d7
XClock*background: #14140d
XClock*majorColor:  rgba:rgb(230, 226, 215)
XClock*minorColor:  rgba:rgb(147, 145, 131)
XClock*hourColor:   rgba:rgb(168, 165, 108)
XClock*minuteColor: rgba:rgb(168, 165, 108)
XClock*secondColor: rgba:rgb(255, 123, 110)

! Set depth to make transparency work.
URxvt*depth: 32
