! Black color that will not be affected by bold highlighting.
*.base066: #121317
*base066:  #121317

! Xclock colors.
XClock*foreground: #e2e2e7
XClock*background: #121317
XClock*majorColor:  rgba:rgb(226, 226, 231)
XClock*minorColor:  rgba:rgb(142, 144, 152)
XClock*hourColor:   rgba:rgb(143, 164, 199)
XClock*minuteColor: rgba:rgb(143, 164, 199)
XClock*secondColor: rgba:rgb(255, 123, 110)

! Set depth to make transparency work.
URxvt*depth: 32
