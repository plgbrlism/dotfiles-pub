// ~~ layout ~~

layout {
    gaps 12
    background-color "transparent"

    border     { off; }
    focus-ring { off; }
    shadow     { off; }

	insert-hint {
        color "rgba(134, 166, 196, 0.8)"
    }

    tab-indicator {
    	active-color "hsl(209, 34%, 65%)"
    	inactive-color "hsl(210, 7%, 28%)"
    	urgent-color "#ff7b6e"
    }
}

overview {
	backdrop-color "rgba(134, 166, 196, 1.0)"
	workspace-shadow { off; }
}

window-rule {
    match is-floating=true
    border {
        on
        width 2
        active-color "rgba(134, 166, 196, 1.0)"
        inactive-color "rgba(66, 71, 76, 1.0)"
    }
    focus-ring {
        on
        width 2
        active-color "rgba(134, 166, 196, 1.0)"
        inactive-color "rgba(66, 71, 76, 1.0)"    	
    }
}

recent-windows {
    highlight {
        active-color "hsl(210, 59%, 79%)"
        urgent-color "hsl(5, 100%, 72%)"        
        padding 20
        corner-radius 8
    }
}
