// ~~ layout ~~

layout {
    gaps 12
    background-color "transparent"

    border     { off; }
    focus-ring { off; }
    shadow     { off; }

	insert-hint {
        color "rgba(167, 157, 200, 0.8)"
    }

    tab-indicator {
    	active-color "hsl(254, 28%, 70%)"
    	inactive-color "hsl(262, 5%, 29%)"
    	urgent-color "#ff7b6e"
    }
}

overview {
	backdrop-color "rgba(167, 157, 200, 1.0)"
	workspace-shadow { off; }
}

window-rule {
    match is-floating=true
    border {
        on
        width 2
        active-color "rgba(167, 157, 200, 1.0)"
        inactive-color "rgba(72, 69, 77, 1.0)"
    }
    focus-ring {
        on
        width 2
        active-color "rgba(167, 157, 200, 1.0)"
        inactive-color "rgba(72, 69, 77, 1.0)"    	
    }
}

recent-windows {
    highlight {
        active-color "hsl(255, 56%, 84%)"
        urgent-color "hsl(5, 100%, 72%)"        
        padding 20
        corner-radius 8
    }
}
