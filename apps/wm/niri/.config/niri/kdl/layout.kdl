// ~~ layout ~~

layout {
    gaps 12
    background-color "transparent"

    border     { off; }
    focus-ring { off; }
    shadow     { off; }

	insert-hint {
        color "rgba(132, 172, 141, 0.8)"
    }

    tab-indicator {
    	active-color "hsl(134, 19%, 60%)"
    	inactive-color "hsl(120, 4%, 27%)"
    	urgent-color "#ff7b6e"
    }
}

overview {
	backdrop-color "rgba(132, 172, 141, 1.0)"
	workspace-shadow { off; }
}

window-rule {
    match is-floating=true
    border {
        on
        width 2
        active-color "rgba(132, 172, 141, 1.0)"
        inactive-color "rgba(66, 72, 66, 1.0)"
    }
    focus-ring {
        on
        width 2
        active-color "rgba(132, 172, 141, 1.0)"
        inactive-color "rgba(66, 72, 66, 1.0)"    	
    }
}

recent-windows {
    highlight {
        active-color "hsl(133, 30%, 74%)"
        urgent-color "hsl(5, 100%, 72%)"        
        padding 20
        corner-radius 8
    }
}
