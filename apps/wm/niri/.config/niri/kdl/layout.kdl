// ~~ layout ~~

layout {
    gaps 12
    background-color "transparent"

    border     { off; }
    focus-ring { off; }
    shadow     { off; }

	insert-hint {
        color "rgba(151, 169, 121, 0.8)"
    }

    tab-indicator {
    	active-color "hsl(82, 22%, 57%)"
    	inactive-color "hsl(78, 7%, 26%)"
    	urgent-color "#ff7b6e"
    }
}

overview {
	backdrop-color "rgba(151, 169, 121, 1.0)"
	workspace-shadow { off; }
}

window-rule {
    match is-floating=true
    border {
        on
        width 2
        active-color "rgba(151, 169, 121, 1.0)"
        inactive-color "rgba(69, 72, 62, 1.0)"
    }
    focus-ring {
        on
        width 2
        active-color "rgba(151, 169, 121, 1.0)"
        inactive-color "rgba(69, 72, 62, 1.0)"    	
    }
}

recent-windows {
    highlight {
        active-color "hsl(82, 34%, 70%)"
        urgent-color "hsl(5, 100%, 72%)"        
        padding 20
        corner-radius 8
    }
}
