// ~~ layout ~~

layout {
    gaps 12
    background-color "transparent"

    border     { off; }
    focus-ring { off; }
    shadow     { off; }

	insert-hint {
        color "rgba(205, 151, 115, 0.8)"
    }

    tab-indicator {
    	active-color "hsl(24, 47%, 63%)"
    	inactive-color "hsl(21, 14%, 28%)"
    	urgent-color "#ff7b6e"
    }
}

overview {
	backdrop-color "rgba(205, 151, 115, 1.0)"
	workspace-shadow { off; }
}

window-rule {
    match is-floating=true
    border {
        on
        width 2
        active-color "rgba(205, 151, 115, 1.0)"
        inactive-color "rgba(81, 68, 61, 1.0)"
    }
    focus-ring {
        on
        width 2
        active-color "rgba(205, 151, 115, 1.0)"
        inactive-color "rgba(81, 68, 61, 1.0)"    	
    }
}

recent-windows {
    highlight {
        active-color "hsl(24, 83%, 77%)"
        urgent-color "hsl(5, 100%, 72%)"        
        padding 20
        corner-radius 8
    }
}
