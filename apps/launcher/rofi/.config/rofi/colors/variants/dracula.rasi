/* Dracula */
* {
    background:      #282a36;
    surface:         #1e1f29;
    overlay:         #44475a;
    foreground:      #f8f8f2;
    muted:           #6272a4;
    cursor:          #ff79c6;
    primary:         #bd93f9;
    secondary:       #ff79c6;
    success:         #50fa7b;
    warning:         #f1fa8c;
    error:           #ff5555;
    info:            #8be9fd;
    border:          #44475a;
    selection:       #44475a;
}
