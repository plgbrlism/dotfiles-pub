# dunst x11 and wayland notifier
# generated by rizzoo
# note: dunst config is not modular

[global]
monitor = 0
follow = mouse
width = (0, 300)
height = (0, 200)
offset = (20, 80)
origin = top-right
font = "JetbrainsMono Nerd Font 10"

format = "<b>%s</b>\n%b"
body = "%b"

frame_width = 2
separator_height = 2
padding = 8
horizontal_padding = 8
corner_radius = 12
transparency = 0

separator_color = frame

icon_position = left
max_icon_size = 32

mouse_left_click = close_current
mouse_middle_click = close_all
mouse_right_click = context

[urgency_low]
background = "#1e2024"
foreground = "#8f9098"
frame_color = "#1e2024"
timeout = 5

[urgency_normal]
background = "#1e2024"
foreground = "#e2e2e7"
frame_color = "#92a3c8"
timeout = 10

[urgency_critical]
background = "#ffdad6"
foreground = "#c32220"
frame_color = "#ff7b6e"
timeout = 0
