# dunst x11 and wayland notifier — Calamus Papyrus
# generated by calamus
# note: dunst config is not modular

[global]
monitor = 0
follow = mouse
width = (0, 300)
height = (0, 200)
offset = (20, 80)
origin = top-right
font = "JetbrainsMono Nerd Font 10"

format = "**%s**\n%b"
body = "%b"

frame_width = 2
separator_height = 2
padding = 8
horizontal_padding = 8
corner_radius = 12
transparency = 0

separator_color = frame

icon_position = left
max_icon_size = 32

mouse_left_click = close_current
mouse_middle_click = close_all
mouse_right_click = context

[urgency_low]
background = "#f2eee0"
foreground = "#48473a"
frame_color = "#cac7b6"
timeout = 5

[urgency_normal]
background = "#f2eee0"
foreground = "#1c1c14"
frame_color = "#636122"
timeout = 10

[urgency_critical]
background = "#da342e"
foreground = "#fffbff"
frame_color = "#bb1b1b"
timeout = 0
