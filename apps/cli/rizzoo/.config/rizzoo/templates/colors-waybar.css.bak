/*
 waybar colors
 generated by rizzoo — adaptive to light/dark mode
*/

@define-color primary {{ primary }};
@define-color on-primary {{ on_primary }};
@define-color primary-container {{ primary_container }};
@define-color on-primary-container {{ on_primary_container }};
@define-color primary-fixed {{ primary_fixed }};
@define-color primary-fixed-dim {{ primary_fixed_dim }};
@define-color on-primary-fixed {{ on_primary_fixed }};
@define-color on-primary-fixed-variant {{ on_primary_fixed_variant }};
@define-color secondary {{ secondary }};
@define-color on-secondary {{ on_secondary }};
@define-color secondary-container {{ secondary_container }};
@define-color on-secondary-container {{ on_secondary_container }};
@define-color secondary-fixed {{ secondary_fixed }};
@define-color secondary-fixed-dim {{ secondary_fixed_dim }};
@define-color on-secondary-fixed {{ on_secondary_fixed }};
@define-color on-secondary-fixed-variant {{ on_secondary_fixed_variant }};
@define-color tertiary {{ tertiary }};
@define-color on-tertiary {{ on_tertiary }};
@define-color tertiary-container {{ tertiary_container }};
@define-color on-tertiary-container {{ on_tertiary_container }};
@define-color tertiary-fixed {{ tertiary_fixed }};
@define-color tertiary-fixed-dim {{ tertiary_fixed_dim }};
@define-color on-tertiary-fixed {{ on_tertiary_fixed }};
@define-color on-tertiary-fixed-variant {{ on_tertiary_fixed_variant }};
@define-color error {{ error }};
@define-color on-error {{ on_error }};
@define-color error-container {{ error_container }};
@define-color on-error-container {{ on_error_container }};
@define-color error-fixed {{ error_fixed }};
@define-color error-fixed-dim {{ error_fixed_dim }};
@define-color on-error-fixed {{ on_error_fixed }};
@define-color on-error-fixed-variant {{ on_error_fixed_variant }};
@define-color surface {{ surface }};
@define-color on-surface {{ on_surface }};
@define-color surface-container {{ surface_container }};
@define-color surface-container-low {{ surface_container_low }};
@define-color surface-container-high {{ surface_container_high }};
@define-color surface-container-highest {{ surface_container_highest }};
@define-color surface-bright {{ surface_bright }};
@define-color surface-dim {{ surface_dim }};
@define-color on-surface-variant {{ on_surface_variant }};
@define-color surface-tint {{ surface_tint }};
@define-color surface-container-lowest {{ surface_container_lowest }};
@define-color outline {{ outline }};
@define-color outline-variant {{ outline_variant }};
@define-color inverse-surface {{ inverse_surface }};
@define-color inverse-on-surface {{ inverse_on_surface }};
@define-color inverse-primary {{ inverse_primary }};
@define-color background {{ background }};
@define-color on-background {{ on_background }};
@define-color shadow {{ shadow }};
@define-color scrim {{ scrim }};

/* === custom colors from [custom_colors] in config.toml ===
   fall back to a Material role when the custom color is not set */
@define-color success {{ custom_success ? custom_success : primary }};
@define-color success-fg {{ custom_success ? on_surface : on_primary }};
@define-color warning {{ custom_warning ? custom_warning : tertiary }};
@define-color danger {{ custom_danger ? custom_danger : error }};

/* === adaptive bar colors (mode-aware) ===
   `mode == dark` picks the dark branch; bare vars already follow the mode */
@define-color bar-bg    {{ mode == dark ? surface_container : surface_container_lowest }};
@define-color bar-fg    {{ mode == dark ? on_surface : on_surface_variant }};
@define-color bar-border{{ mode == dark ? outline_variant : outline }};
@define-color bar-text  {{ mode == dark ? on_surface : on_surface }};
@define-color active    {{ custom_success ? custom_success : primary }};
@define-color inactive  {{ mode == dark ? outline_variant : outline }};
