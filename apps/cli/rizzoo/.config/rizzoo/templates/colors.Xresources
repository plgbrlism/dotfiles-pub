! colors.Xresources - generated by 'rwal'
*foreground:        {{ on_surface }}
*background:        {{ background }}
*.foreground:       {{ on_surface }}
*.background:       {{ background }}
emacs*foreground:   {{ on_surface }}
emacs*background:   {{ background }}
URxvt*foreground:   {{ on_surface }}
XTerm*foreground:   {{ on_surface }}
UXTerm*foreground:  {{ on_surface }}
URxvt*background:   {{ background }}
XTerm*background:   {{ background }}
UXTerm*background:  {{ background }}
URxvt*cursorColor:  {{ primary }}
XTerm*cursorColor:  {{ primary }}
UXTerm*cursorColor: {{ primary }}
URxvt*borderColor:  {{ background }}

! Colors 0-15.
*.base00: {{ background }}
*base00:  {{ background }}
*.base01: {{ error }}
*base01:  {{ error }}
*.base02: {{ primary }}
*base02:  {{ primary }}
*.color3: {{ secondary }}
*color3:  {{ secondary }}
*.base04: {{ tertiary }}
*base04:  {{ tertiary }}
*.base05: {{ on_secondary_container }}
*base05:  {{ on_secondary_container }}
*.base06: {{ on_primary_container }}
*base06:  {{ on_primary_container }}
*.color7: {{ on_surface }}
*color7:  {{ on_surface }}
*.color8: {{ surface_bright }}
*color8:  {{ surface_bright }}
*.base09: {{ error }}
*base09:  {{ error }}
*.base010: {{ primary }}
*base010:  {{ primary }}
*.base011: {{ secondary }}
*base011:  {{ secondary }}
*.base012: {{ tertiary }}
*base012:  {{ tertiary }}
*.base013: {{ on_secondary_container }}
*base013:  {{ on_secondary_container }}
*.base014: {{ on_primary_container }}
*base014:  {{ on_primary_container }}
*.base015: {{ on_surface }}
*base015:  {{ on_surface }}

! Black color that will not be affected by bold highlighting.
*.base066: {{ background }}
*base066:  {{ background }}

! Xclock colors.
XClock*foreground: {{ on_surface }}
XClock*background: {{ background }}
XClock*majorColor:  rgba:{{ on_surface:rgb }}
XClock*minorColor:  rgba:{{ outline:rgb }}
XClock*hourColor:   rgba:{{ primary:rgb }}
XClock*minuteColor: rgba:{{ primary:rgb }}
XClock*secondColor: rgba:{{ error:rgb }}

! Set depth to make transparency work.
URxvt*depth: 32
