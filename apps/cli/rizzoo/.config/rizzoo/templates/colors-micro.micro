# micro editor colorscheme
# generated by rizzoo 

color-link color-column "{{ surface_container }},{{ background }}"
color-link comment "{{ outline }},{{ background }}"
color-link constant "{{ primary }},{{ background }}"
color-link constant.number "{{ tertiary }},{{ background }}"
color-link constant.specialChar "{{ secondary }},{{ background }}"
color-link constant.string "{{ primary }},{{ background }}"
color-link current-line-number "{{ primary }},{{ background }}"
color-link cursor-line "{{ surface_container }}"
color-link default "{{ on_surface }},{{ background }}"
color-link diff-added "{{ primary }}"
color-link diff-modified "{{ secondary }}"
color-link diff-deleted "{{ error }}"
color-link divider "{{ surface_container }},{{ surface }}"
color-link error "bold {{ on_error }},{{ error }}"
color-link gutter-error "{{ on_error }},{{ error }}"
color-link gutter-warning "{{ on_surface_variant }},{{ secondary_container }}"
color-link hlsearch "{{ on_secondary_container }},{{ secondary_container }}"
color-link identifier "{{ secondary }},{{ background }}"
color-link identifier.macro "{{ tertiary }},{{ background }}"
color-link indent-char "{{ surface_container }},{{ background }}"
color-link line-number "{{ outline }},{{ surface_dim }}"
color-link preproc "{{ tertiary }},{{ background }}"
color-link scrollbar "{{ outline }},{{ surface_container }}"
color-link special "{{ tertiary }},{{ background }}"
color-link statement "{{ primary }},{{ background }}"
color-link statusline "{{ on_surface }},{{ surface_container }}"
color-link symbol "{{ outline }},{{ background }}"
color-link symbol.brackets "{{ outline }},{{ background }}"
color-link symbol.operator "{{ outline }},{{ background }}"
color-link tabbar "{{ outline }},{{ surface }}"
color-link todo "bold {{ tertiary }},{{ background }}"
color-link type "{{ secondary }},{{ background }}"
color-link underlined "underline {{ on_surface }},{{ background }}"
color-link match-brace "{{ on_secondary_container }},{{ secondary_container }}"
color-link tab-error "{{ error }}"
color-link trailingws "{{ error }}"
