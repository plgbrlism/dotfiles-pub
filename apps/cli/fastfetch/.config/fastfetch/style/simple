{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {"9": "white"},
    "type": "auto",   // use distro logo or "none" if you want it blank
    "source": "~/.config/fastfetch/custom_logos/paul",
    "position": "top",
    "padding": {
      "right": 1,
      "left": 3
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 17,
      "paddingLeft": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": " {#magenta} ╭───────────╮"
    },
    {
      "key": "│   user   │ ",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "31"   // red
    },
    {
      "type": "host",
      "key": "│   dev    │",
      "keyColor": "green",
      "format": "{2}",
    },
    {
      "key": "│ 󰌽  dist   │ ",
      "type": "os",
      "format": "{name}",
      "keyColor": "32"   // green
    },
    {
      "key": "│   wm     │ ",
      "type": "wm"
    },
    {
      "key": "│ 󰚭  os_age │ ",
      "type": "command",
      "keyColor": "35",   // blue
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "key": "│   shell  │ ",
      "type": "shell",
      "keyColor": "35"   // magenta
    },
    {
      "key": "│ 󰏖  pkgs   │ ",
      "type": "packages",
      "keyColor": "31"   // red again
    },
    {
      "key": "│   ram    │ ",
      "type": "memory",
      "format": "{used} / {total}",
      "keyColor": "33"   // yellow
    },
    {
      "type": "custom",
      "format": " {#green} ├───────────┤"
    },
    {
      "type": "custom",
      "format": " {#cyan} │   colors │ {#white}󰆥{#} {#red}󰆥{#} {#yellow}󰆥{#} {#green}󰆥{#} {#cyan}󰆥{#} {#blue}󰆥{#} {#magenta}󰆥{#} {#black}󰆥{#}",
    },
    {
      "type": "custom",
      "format": " {#blue} ╰───────────╯"
    }
  ]
}


