{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
  "color": {
    	"1": "34",
    	"2": "36 ",
    	"3": "35 ",
    	},
    "type": "auto",   // use distro logo or "none" if you want it blank
    "source": "~/.config/fastfetch/custom/dawg",
    "position": "top",
    "padding": {
      "right": 1,
      "left": 3
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 17,
      "paddingLeft": 2
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": " {#33} ╭───────────╮"
    },
    {
      "key": "│   usr    │ ",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "34"  
    },
    {
      "type": "host",
      "key": "│   dev    │",
      "keyColor": "35",
      "format": "{2}",
    },
    {
      "key": "│ 󰌽  dst    │ ",
      "type": "os",
      "format": "{name}",
      "keyColor": "36"   
    },
    {
      "key": "│   wm     │ ",
      "type": "wm",
      "color": "33",
    },
    {
      "key": "│ 󰚭  age    │ ",
      "type": "command",
      "keyColor": "34",   
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "key": "│   shll   │ ",
      "type": "shell",
      "keyColor": "35"   
    },
    {
      "key": "│ 󰏖  pkg    │ ",
      "type": "packages",
      "keyColor": "36"   
    },
    {
      "key": "│   ram    │ ",
      "type": "memory",
      "format": "{used} / {total}",
      "keyColor": "34"   
    },
    {
      "type": "custom",
      "format": " {#35} ├───────────┤"
    },
    {
      "type": "custom",
      "format": " {#36} │   colors │ {#36}󱑽{#} {#31}󰵲{#} {#32}󰽥{#} {#33}󰖝{#} {#34}{#} {#35}{#} {#36}󰈸{#} ",
    },
    {
      "type": "custom",
      "format": " {#33} ╰───────────╯"
    }
  ]
}


