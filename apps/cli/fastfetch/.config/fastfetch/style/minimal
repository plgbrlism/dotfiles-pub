{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
    	"1": "34",
    	"2": "36 ",
    	"3": "35 ",
    	},
    "type": "auto",   // use distro logo or "none" if you want it blank
    "source": "~/.config/fastfetch/custom/paul",
    //"source": "none",
    "position": "top",
    "padding": {
      "right": 1,
      "left": 3
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 17,
      "paddingLeft": 3
    }
  },
  "modules": [
    {
      "format": " ",
      "type": "custom",
    },
    {
      "key": "   usr    ",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "34"   // red
    },
    {
      "type": "host",
      "key": "   dev    ",
      "format": "{2}",
      "keyColor": "36",
    },
    {
      "key": " 󰌽  dst   ",
      "type": "os",
      "format": "{name}",
      "keyColor": "35"   // green
    },
    {
      "key": "   wm      ",
      "type": "wm",
      "keyColor": "34"
    },
    {
      "key": " 󰚭  age  ",
      "type": "command",
      "keyColor": "36",   // blue
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "key": "   shll   ",
      "type": "shell",
      "keyColor": "35"   // magenta
    },
    {
      "key": " 󰏖  pkg     ",
      "type": "packages",
      "keyColor": "34"   // red again
    },
    {
      "key": "   ram ",
      "type": "memory",
      "format": "{used} / {total}",
      "keyColor": "36"   // yellow
    },
    {
      "key": "   clrs     {#36}󱑽{#} {#31}󰵲{#} {#32}󰽥{#} {#33}󰖝{#} {#34}{#} {#35}{#} {#36}󰈸{#}",
      "type": "custom",
      "keyColor": "35" 
    },
    {
      "format": " ",
      "type": "custom",
    }
  ]
}


