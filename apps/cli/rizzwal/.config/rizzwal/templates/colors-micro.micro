color-link color-column "{{ surface.hex }},{{ background.hex }}"
color-link comment "{{ muted.hex }},{{ background.hex }}"
color-link constant "{{ primary.hex }},{{ background.hex }}"
color-link constant.number "{{ warning.hex }},{{ background.hex }}"
color-link constant.specialChar "{{ secondary.hex }},{{ background.hex }}"
color-link constant.string "{{ warning.hex }},{{ background.hex }}"
color-link current-line-number "{{ primary.hex }},{{ background.hex }}"
color-link cursor-line "{{ surface.hex }}"
color-link default "{{ foreground.hex }},{{ background.hex }}"
color-link diff-added "{{ success.hex }}"
color-link diff-modified "{{ warning.hex }}"
color-link diff-deleted "{{ error.hex }}"
color-link divider "{{ border.hex }},{{ surface.hex }}"
color-link error "bold {{ foreground.hex }},{{ error.hex }}"
color-link gutter-error "{{ foreground.hex }},{{ error.hex }}"
color-link gutter-warning "{{ foreground.hex }},{{ warning.hex }}"
color-link hlsearch "{{ background.hex }},{{ selection.hex }}"
color-link identifier "{{ secondary.hex }},{{ background.hex }}"
color-link identifier.macro "{{ success.hex }},{{ background.hex }}"
color-link indent-char "{{ border.hex }},{{ background.hex }}"
color-link line-number "{{ muted.hex }},{{ overlay.hex }}"
color-link preproc "{{ info.hex }},{{ background.hex }}"
color-link scrollbar "{{ muted.hex }},{{ overlay.hex }}"
color-link special "{{ info.hex }},{{ background.hex }}"
color-link statement "{{ primary.hex }},{{ background.hex }}"
color-link statusline "{{ foreground.hex }},{{ surface.hex }}"
color-link symbol "{{ muted.hex }},{{ background.hex }}"
color-link symbol.brackets "{{ muted.hex }},{{ background.hex }}"
color-link symbol.operator "{{ muted.hex }},{{ background.hex }}"
color-link tabbar "{{ muted.hex }},{{ surface.hex }}"
color-link todo "bold {{ warning.hex }},{{ background.hex }}"
color-link type "{{ secondary.hex }},{{ background.hex }}"
color-link underlined "underline {{ foreground.hex }},{{ background.hex }}"
color-link match-brace "{{ background.hex }},{{ secondary.hex }}"
color-link tab-error "{{ error.hex }}"
color-link trailingws "{{ error.hex }}"
